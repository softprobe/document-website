{
  "name": "softprobe-docs",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev --port ${PORT:-5173}",
    "docs:build": "vitepress build",
    "docs:preview": "vitepress preview",
    "validate:testing-ia": "node scripts/validate-testing-ia.mjs",
    "migrate:cli-to-testing": "node scripts/complete-cli-to-testing-migration.mjs",
    "migrate": "node scripts/migrate-content.mjs",
    "deploy": "npm run docs:build && env -u CLOUDFLARE_API_TOKEN -u CF_API_TOKEN wrangler deploy",
    "docs:serve": "npm run docs:build && wrangler dev",
    "typecheck:worker": "tsc -p tsconfig.worker.json",
    "test:auth": "node --test tests/docs-auth.test.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/node": "^26.6.5",
    "mermaid": "^11.15.0",
    "search-insights": "^2.17.3",
    "typescript": "^7.0.2",
    "vitepress": "^1.6.3",
    "vitepress-plugin-llms": "^1.13.3",
    "vitepress-plugin-mermaid": "^2.0.17",
    "wrangler": "^4.14.0"
  }
}
